################################################################################################
##
## Build file for a QNX operating system
##
################################################################################################

[-optional]
[+keeplinked]
[image=0x80000]
[virtual=aarch64le,raw -compress] boot = {
    startup-bcm2711-rpi4 -v -D miniuart -W 2500 -u reg -r 0,4096,1 
    PATH=/proc/boot:/sbin:/bin:/usr/bin:/usr/sbin LD_LIBRARY_PATH=/proc/boot:/lib:/usr/lib:/lib/dll procnto-smp-instr -v
}

[+script] startup-script = {
    SYSNAME=nto
    TERM=qansi
    ENV=/fs/etc/profile

    procmgr_symlink ../../proc/boot/ldqnx-64.so.2 /usr/lib/ldqnx-64.so.2

    ## Needed for ksh to run the echo command below
    pipe
    slogger2

    display_msg " "
    ksh -c "echo Welcome to QNX $(uname -r) on $(uname -m) !"
    display_msg " "
    
    ############################################################################################
    ## WatchDog utility
    ## If startup is given -W parameter then the wdtkick utility MUST be uncommented below
    ############################################################################################
    display_msg "Starting wdtkick ..."
    wdtkick -W0x24:0x5A028E4C -W0x1c:0x5A000020


    #######################################################################
    ## Console SERIAL driver
    #######################################################################
    display_msg "Starting serial driver (/dev/ser1)"
    devc-serminiuart -b115200 -c500000000 -e -F -u1 0xfe215000,125
    waitfor /dev/ser1
    reopen /dev/ser1


    #######################################################################
    ## SD memory card / eMMC driver
    ## Note: "bmstr_base" option is required for busmaster memory
    ## address translation
    #######################################################################
    display_msg "Starting SDMMC driver (/dev/sd0)"
    devb-sdmmc-bcm2711 mem name=below1G sdio addr=0xfe340000,irq=158 disk name=sd
    waitfor /dev/sd0
    display_msg "SD Driver started"
    
    /scripts/mount_rootfs.sh
    
    #mount the file system 
    #mount -t qnx6 /dev/sd0.lnxdata.3 /fs
    #display_msg "Roofs Mounted at /fs"
    
    ## -- Run rootfs startup script --------------------------
    display_msg "Running board startup script..."
    /fs/scripts/startup.sh
    
    [+session] ksh &
}

[uid=0 gid=0 perms=755] /scripts/mount_rootfs.sh={
#!/bin/sh

echo "Starting dynamic A/B bank mounting script..."

mount -t dos /dev/sd0.ms.0 /mnt/boot

# Parse uEnv.txt securely
OTA_BANK="A"

if [ -f /mnt/boot/uEnv.txt ]; then
    echo "Reading uEnv.txt..."
    OTA_BANK=$(grep "^ota_bank=" /mnt/boot/uEnv.txt | cut -d= -f2)
    if [ -z "\$OTA_BANK" ]; then
        OTA_BANK="A"
    fi
else
    echo "uEnv.txt not found. Defaulting to Bank A."
fi

umount /mnt/boot

echo "Target OTA Bank detected as: $OTA_BANK"

if [ "$OTA_BANK" = "A" ]; then
    echo "Mounting Bank A (/dev/sd0.lnxdata.3) to /fs"
    mount -t qnx6 /dev/sd0.lnxdata.3 /fs
else
    echo "Mounting Bank B (/dev/sd0.lnxdata.4) to /fs"
    mount -t qnx6 /dev/sd0.lnxdata.4 /fs
fi

echo "Rootfs successfully mounted!"
}


[uid=0 gid=0]

[type=link] /bin/sh=/bin/ksh
[type=link] /dev/console=/dev/ser1
[type=link] /tmp=/dev/shmem
[type=link] /etc = /fs/etc
[type=link] /var = /fs/var
[type=link] /usr/libexec = /fs/usr/libexec
[type=link] /home = /fs/home

################################################################################################
## WDT driver
################################################################################################
/bin/wdtkick=wdtkick

################################################################################################
## Serial drivers
################################################################################################
/sbin/devc-serminiuart=devc-serminiuart
/sbin/devc-serpl011=devc-serpl011


################################################################################################
## Block drivers
################################################################################################
/sbin/devb-sdmmc-bcm2711=devb-sdmmc-bcm2711

################################################################################################
## Block driver support libraries
################################################################################################
/lib/libcam.so=libcam.so
/lib/dll/io-blk.so=io-blk.so
/lib/dll/cam-disk.so=cam-disk.so
/lib/dll/cam-cdrom.so=cam-cdrom.so
/lib/dll/fs-qnx6.so=fs-qnx6.so
/lib/dll/fs-dos.so=fs-dos.so

################################################################################################
## Shell and essential debug utilities
################################################################################################
/bin/ksh=ksh
/bin/mount=mount
/bin/umount=umount
/bin/df=df
/bin/on=on
/bin/pidin=pidin
/bin/slay=slay
/bin/slog2info=slog2info
/bin/slogger2=slogger2
/bin/waitfor=waitfor
/bin/sync=sync
/bin/hostname=hostname
/bin/kill=kill


/sbin/pipe=pipe
/sbin/shutdown=shutdown

/usr/bin/hd=hd
/usr/bin/top=top
/usr/bin/use=use

/usr/sbin/dumper=dumper
/usr/sbin/random=random
/sbin/fdisk=fdisk
/sbin/chkqnx6fs=chkqnx6fs
/sbin/mkqnx6fs=mkqnx6fs

################################################################################################
## Toybox commands
## Note: The toybox package combines many common Linux command line utilities together into
##       a single, BSD-licensed executable. The following toybox commands are supported.
##       Use one of the following commands to access help for a toybox command:
##         toybox command_name --help
##         command_name --help
################################################################################################
/usr/bin/toybox=toybox

[type=link] /bin/cat=/usr/bin/toybox
