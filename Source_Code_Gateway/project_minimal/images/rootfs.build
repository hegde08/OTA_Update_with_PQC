################################################################################################
## WIFI firmware and WPA utilities
################################################################################################
[search=../install/etc/firmware] /etc/hotspot/firmware.bin=../prebuilt/etc/firmware/brcmfmac43455-sdio.bin
[search=../install/etc/firmware] /etc/hotspot/nvram.txt=../prebuilt/etc/firmware/brcmfmac43455-sdio.txt
