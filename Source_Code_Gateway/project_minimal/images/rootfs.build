/usr/sbin/wpa_passphrase=wpa_passphrase-2.11
/usr/sbin/wpa_supplicant=wpa_supplicant-2.11


[perms=644]etc/wifi/qwdi_wifi.conf = {
fw=/fs/etc/hotspot/firmware.bin
nvram=/fs/etc/hotspot/nvram.txt
clm_blob=/fs/etc/hotspot/firmware.clm_blob
sdio_baseaddr=0xfe300000
sdio_irq=158
drv_supp=3
key_delay=5
sdio_verbose=0
dhd_verbose=1
qwdi_dbg_level=0
}

/etc/wpa_supplicant.conf = ../prebuilt/config/wpa_supplicant.conf

[perms=644]etc/io-sock/io-sock.conf = {
hw.dhdsdio.dev0="rpi4"
dev.qwdi_wifi.conf="/fs/etc/wifi/qwdi_wifi.conf"
}

[type=file]
/var/certs/ecu.key=../prebuilt/certificates/ecu.key

[type=file]
/var/certs/ecu.crt=../prebuilt/certificates/ecu.crt

[type=file]
/var/certs/rootCA.crt=../prebuilt/certificates/rootCA.crt

[type=file]
/var/keys/public_key_fn_dsa.bin=../prebuilt/keys/public_key_fn_dsa.bin

[type=file]
/var/keys/public_key_ml_dsa.bin=../prebuilt/keys/public_key_ml_dsa.bin

[type=file]
/var/keys/public_key_ecdsa.pem=../prebuilt/keys/public_key_ecdsa.pem

[type=file]
/var/keys/aead_key.bin=../prebuilt/keys/aead_key.bin

[perms=0755] /bin/Verifier = ../../verifier/build/aarch64le-release/Verifier
[perms=0755] /bin/Writer = ../../writer/build/aarch64le-release/Writer
[perms=0755] /bin/download_agent = ../../download_agent/build/aarch64le-release/download_agent

################################################################################################
## Firmware Version (Anti-rollback tracking)
################################################################################################
[uid=0 gid=0 perms=0644] /var/version/gateway_version = {
1.0.0
}

[uid=0 gid=0 perms=0644] /var/version/end_ecu_version = {
1.0.0
}
